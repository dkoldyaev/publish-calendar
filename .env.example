# ==============================================================================
# AUTHORITATIVE ENVIRONMENT CONFIGURATION INVENTORY (.env.example)
# ==============================================================================
# Strict Environment-Only Policy:
# - Every variable listed here is explicitly validated at startup/build time.
# - Missing, empty, or malformed variables cause immediate ConfigurationError.
# - No fallback values exist in source code or Docker Compose configurations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend HTTP Server & Logging (Used in: apps/api, docker-compose.yml)
# ------------------------------------------------------------------------------

# Bind host address for the backend API server.
# Format: IPv4/IPv6 address or hostname.
API_HOST=0.0.0.0

# TCP port on which the backend API server listens.
# Format: Integer between 1 and 65535.
API_PORT=4000

# Publicly reachable origin URL of the web frontend (used for links & push payloads).
# Format: Valid HTTP/HTTPS URL without trailing slash.
PUBLIC_WEB_ORIGIN=http://localhost:8080

# Publicly reachable origin URL of the backend API.
# Format: Valid HTTP/HTTPS URL without trailing slash.
PUBLIC_API_ORIGIN=http://localhost:4000

# Comma-separated list of allowed CORS origins for API requests.
# Format: Comma-separated valid HTTP/HTTPS URLs.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Minimum structured log level emitted by the backend and worker.
# Format: One of: debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Authentication & Security (Used in: apps/api, docker-compose.yml)
# ------------------------------------------------------------------------------

# HMAC signing secret for session tokens.
# Format: High-entropy secret string, minimum 32 characters. (PLACEHOLDER)
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_HMAC_AUTH_SECRET_KEY

# Default personal user account UUID for single-owner workspace isolation.
# Format: RFC 4122 UUID v4 string.
AUTH_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001

# Access code required to exchange for a signed session token.
# Format: Non-empty secret passphrase, minimum 8 characters. (PLACEHOLDER)
AUTH_DEFAULT_ACCESS_CODE=REPLACE_WITH_PERSONAL_ACCESS_CODE

# Session token validity period in seconds.
# Format: Positive integer (e.g., 2592000 = 30 days).
AUTH_TOKEN_TTL_SECONDS=2592000

# Maximum requests permitted per IP within a rate-limit window.
# Format: Positive integer.
RATE_LIMIT_MAX_REQUESTS=300

# Rate-limit window duration in milliseconds.
# Format: Positive integer.
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
#    (Used in: apps/api, docker-compose.yml, docker-compose.override.yml.example)
# ------------------------------------------------------------------------------

# Full PostgreSQL connection string used by the API and notification scheduler.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://publish_user:REPLACE_WITH_DB_PASSWORD@postgres:5432/publish_calendar

# Maximum number of concurrent connections in the PostgreSQL pool.
# Format: Positive integer between 1 and 100.
DATABASE_POOL_MAX=10

# Timeout in milliseconds when acquiring a PostgreSQL connection.
# Format: Positive integer.
DATABASE_CONNECT_TIMEOUT_MS=5000

# PostgreSQL username used by the local development container in docker-compose.override.yml.
# Format: Non-empty identifier string.
POSTGRES_USER=publish_user

# PostgreSQL password used by the local development container in docker-compose.override.yml.
# Format: Non-empty secret string. (PLACEHOLDER)
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# PostgreSQL database name used by the local development container in docker-compose.override.yml.
# Format: Non-empty identifier string.
POSTGRES_DB=publish_calendar

# Internal TCP port for PostgreSQL in docker-compose.override.yml.
# Format: Integer between 1 and 65535.
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. File Storage Adapter Configuration (Used in: apps/api, docker-compose.yml)
# ------------------------------------------------------------------------------

# Active storage backend driver for photograph binaries.
# Enablement rule:
#   - When STORAGE_DRIVER=local: LOCAL_STORAGE_DIR is required; S3_* variables are not required.
#   - When STORAGE_DRIVER=s3: all S3_* variables below are required.
# Format: One of: local | s3
STORAGE_DRIVER=local

# Filesystem directory path for storing photograph binaries when STORAGE_DRIVER=local.
# Format: Non-empty filesystem path.
LOCAL_STORAGE_DIR=/var/lib/publish-calendar/storage

# S3 API endpoint URL (required when STORAGE_DRIVER=s3).
# Format: Valid HTTP/HTTPS URL.
S3_ENDPOINT=http://localhost:9000

# S3 region identifier.
# Format: Non-empty region string (e.g., us-east-1, eu-central-1).
S3_REGION=us-east-1

# Name of the S3 bucket storing photograph binary files.
# Format: Valid S3 bucket name (3-63 lowercase alphanumeric/hyphen chars).
S3_BUCKET=publish-calendar-photos

# S3 access key ID.
# Format: Non-empty credential string. (PLACEHOLDER)
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY_ID

# S3 secret access key.
# Format: Non-empty secret credential string. (PLACEHOLDER)
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_ACCESS_KEY

# Whether to force path-style S3 URLs (true for MinIO/local S3, false for virtual-hosted S3).
# Format: Boolean string: true | false
S3_FORCE_PATH_STYLE=true

# Time-to-live in seconds for presigned S3 upload/download URLs.
# Format: Positive integer between 60 and 86400.
S3_PRESIGNED_URL_TTL_SECONDS=900

# Operational timeout in milliseconds for S3 storage requests.
# Format: Positive integer.
S3_OPERATION_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 5. Upload & ZIP Validation Limits (Used in: apps/api, docker-compose.yml)
# ------------------------------------------------------------------------------

# Maximum allowed size in bytes for a single photograph file (e.g., 26214400 = 25 MiB).
# Format: Positive integer.
MAX_UPLOAD_FILE_BYTES=26214400

# Maximum number of photographs allowed in a single batch upload.
# Format: Positive integer.
MAX_BATCH_FILES=100

# Maximum combined size in bytes for an entire upload batch (e.g., 209715200 = 200 MiB).
# Format: Positive integer.
MAX_BATCH_TOTAL_BYTES=209715200

# Maximum allowed uncompressed-to-compressed size ratio for ZIP archive entries (ZIP bomb defense).
# Format: Positive number.
MAX_ZIP_EXPANSION_RATIO=25

# Maximum total extracted bytes allowed per ZIP archive (e.g., 157286400 = 150 MiB).
# Format: Positive integer.
MAX_ZIP_EXTRACTED_BYTES=157286400

# Maximum number of entries allowed inside a single ZIP archive.
# Format: Positive integer.
MAX_ZIP_ENTRIES=500

# ------------------------------------------------------------------------------
# 6. Web Push & Notification Scheduler (Used in: apps/api, docker-compose.yml)
# ------------------------------------------------------------------------------

# VAPID public key (URL-safe Base64) used to authenticate Web Push notifications.
# Format: Base64url string (65 bytes uncompressed P-256 key, ~87 chars).
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U

# VAPID private key (URL-safe Base64) used to sign Web Push notifications.
# Format: Base64url string (~43 chars). (PLACEHOLDER)
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY_BASE64URL

# Contact URI for the Web Push sender as required by RFC 8292.
# Format: mailto: or https: URI.
VAPID_SUBJECT=mailto:notifications@example.com

# Polling interval in milliseconds for the background notification scheduler loop.
# Format: Positive integer.
NOTIFICATION_POLL_INTERVAL_MS=15000

# Maximum delivery attempts for a failing Web Push notification before marking failed.
# Format: Positive integer.
NOTIFICATION_MAX_RETRIES=3

# Initial IANA time zone used when provisioning user settings.
# Format: Valid IANA Time Zone Database name (e.g., Europe/Moscow, Europe/Madrid, UTC).
DEFAULT_TIMEZONE=Europe/Moscow

# Initial daily reminder time in 24-hour format used when provisioning user settings.
# Format: HH:MM (00:00 to 23:59).
DEFAULT_REMINDER_TIME=09:30

# ------------------------------------------------------------------------------
# 7. Frontend PWA & Local Reverse Proxy Configuration
#    (Used in: apps/web, docker-compose.yml, docker-compose.override.yml.example)
# ------------------------------------------------------------------------------

# Port on which the local Traefik reverse proxy listens (used only in docker-compose.override.yml).
# Format: Integer between 1 and 65535.
TRAEFIK_PORT=80

# Internal port on which the web frontend container listens.
# Format: Integer between 1 and 65535.
WEB_PORT=8080

# Backend API origin URL used by the browser application.
# Format: Valid HTTP/HTTPS URL without trailing slash.
VITE_API_ORIGIN=http://localhost:4000

# Public origin URL of the web application.
# Format: Valid HTTP/HTTPS URL without trailing slash.
VITE_PUBLIC_ORIGIN=http://localhost:8080

# VAPID public key exposed to the browser PushManager for subscribing to Web Push.
# Format: Base64url string matching VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U

# Access code used by the client to authenticate with the personal API server.
# Format: Non-empty string matching AUTH_DEFAULT_ACCESS_CODE. (PLACEHOLDER)
VITE_DEFAULT_ACCESS_CODE=REPLACE_WITH_PERSONAL_ACCESS_CODE

# Initial IANA time zone used by the offline-first client before server sync.
# Format: Valid IANA Time Zone Database name.
VITE_DEFAULT_TIMEZONE=Europe/Moscow

# Initial 24-hour daily reminder time used by the offline-first client before server sync.
# Format: HH:MM (00:00 to 23:59).
VITE_DEFAULT_REMINDER_TIME=09:30

# Client-side maximum size in bytes for a single photograph file.
# Format: Positive integer.
VITE_MAX_UPLOAD_FILE_BYTES=26214400

# Client-side maximum number of photographs allowed in a single batch upload.
# Format: Positive integer.
VITE_MAX_BATCH_FILES=100

# Client-side maximum combined size in bytes for an upload batch.
# Format: Positive integer.
VITE_MAX_BATCH_TOTAL_BYTES=209715200

# Client-side maximum allowed uncompressed-to-compressed ratio for ZIP archives.
# Format: Positive number.
VITE_MAX_ZIP_EXPANSION_RATIO=25

# Client-side maximum total extracted bytes per ZIP archive.
# Format: Positive integer.
VITE_MAX_ZIP_EXTRACTED_BYTES=157286400

# Client-side maximum number of entries allowed inside a single ZIP archive.
# Format: Positive integer.
VITE_MAX_ZIP_ENTRIES=500

# Foreground synchronization polling interval in milliseconds.
# Format: Positive integer.
VITE_SYNC_INTERVAL_MS=30000

# Maximum retry attempts for a failed synchronization operation before backoff pause.
# Format: Positive integer.
VITE_SYNC_MAX_RETRIES=5

# Base delay in milliseconds for exponential synchronization retry backoff.
# Format: Positive integer.
VITE_SYNC_RETRY_BASE_MS=1000
